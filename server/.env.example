# Local AI Affiliate Clipper Backend Configuration
PORT=5000

# OpenRouter API Key (https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Opsional: Tentukan model OpenRouter utama (Hanya gunakan model :free agar saldo tidak terpotong)
# Contoh gratis 100%: openrouter/free, google/gemini-2.0-flash-exp:free, meta-llama/llama-3.2-11b-vision-instruct:free
OPENROUTER_MODEL=openrouter/free

# Google Gemini API Direct Fallback (https://aistudio.google.com/)
# Digunakan otomatis jika OpenRouter kehabisan kuota/saldo/overload
GEMINI_API_KEY=your_gemini_api_key_here

# Optional yt-dlp auth fallback for YouTube 429 / "not a bot" checks.
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FILE=./cookies.txt

# Optional downloader fallbacks.
# LOW_DATA_MODE=false (Default: selalu unduh langsung 1080p Full HD murni dari YouTube)
# RAPIDAPI_KEY=your_rapidapi_key_here
# RAPIDAPI_HOST=yt-api.p.rapidapi.com
# COBALT_API_URL=
# COBALT_API_KEY=your_cobalt_api_key_here

# TTS Voiceover Settings (Google Gemini Flash TTS - Free Tier: 10 RPD)
# Default model: gemini-2.5-flash-preview-tts
# Fallback model: gemini-3.1-flash-tts-preview
# Voice: Despina
TTS_PROVIDER=gemini_tts
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_FALLBACK_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Despina
TTS_VOICE=Despina
# Untuk beralih ke Edge TTS (tanpa batas kuota tapi bukan fallback otomatis):
# TTS_PROVIDER=edge_tts
# TTS_VOICE=id-ID-GadisNeural
